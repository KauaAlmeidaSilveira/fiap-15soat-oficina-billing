# Referencia apenas: os Secrets sao criados pelo scripts/deploy-aws.sh do repositorio do OS,
# a partir do .env, dos outputs do Terraform e de .local/chaves. Nunca commitar valores reais.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-billing-secrets
  namespace: oficina
type: Opaque
stringData:
  MERCADOPAGO_ACCESS_TOKEN: "<MERCADOPAGO_ACCESS_TOKEN>"
  MERCADOPAGO_EXTERNAL_POS_ID: "<MERCADOPAGO_EXTERNAL_POS_ID>"
  MERCADOPAGO_WEBHOOK_SECRET: "<MERCADOPAGO_WEBHOOK_SECRET>"
  GMAIL_SMTP_USERNAME: "<GMAIL_SMTP_USERNAME>"
  GMAIL_SMTP_PASSWORD: "<GMAIL_SMTP_PASSWORD>"
  NEW_RELIC_LICENSE_KEY: "<NEW_RELIC_LICENSE_KEY>"
---
apiVersion: v1
kind: Secret
metadata:
  name: oficina-billing-chaves
  namespace: oficina
type: Opaque
stringData:
  sessao.public.key: |
    <conteudo de sessao.public.key>
  aprovacao.private.key: |
    <conteudo de aprovacao.private.key>
  aprovacao.public.key: |
    <conteudo de aprovacao.public.key>
